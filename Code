#Importing the necessary libraries
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
#Font dictionaries 
f3={"Family":"serif"}
rep='y'
df=pd.read_csv("/content/drive/MyDrive/The project/IP/attrition-dataset.csv")
print('Conversion of CSV file to DataFrame')
data = pd.DataFrame(df)
while(rep=='y'):
  print("1-Information about the DataFrame")
  print("2-Displaying dismissed Employees")
  print("3-Displaying non-dismissed Employees")
  print("4-Category of dismissed Employees of the basis of Age")
  print("5-Attrition based on Education Field")
  print("6-Attrition based on Work Life Balance")
  print("7-Attrition based on Environment satisfaction")
  print("8-Attrition based on Performance rating")
  print("9-Attrition based on Job Satisfaction")
  print("10- Exit")
  ch=int(input("Enter choice (1-10) : "))
