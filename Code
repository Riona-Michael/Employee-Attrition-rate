    plt.ylabel("No of Employees",fontdict=f3,labelpad=5,fontsize=10)
    plt.show()
  elif(ch==6):
    print("WorkLifeBalance as a factor in line graph")
    data_attrition_yes = data[data['Attrition'] == 'Yes']
data_WorkLifeBalance=data_attrition_yes['WorkLifeBalance'].value_counts()
