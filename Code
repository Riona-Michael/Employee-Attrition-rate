    print("Analysis of dismissed employees")
    data_attrition_yes = data[data['Attrition'] == 'Yes']
    print(data_attrition_yes)
  elif(ch==3):
    print("Analysis ofundismissed employees")
    data_attrition_no = data[data['Attrition'] == 'No']
    print(data_attrition_no)
  elif(ch==4):
    print("Attition on the basis of Age")
    data_attrition_yes = data[data['Attrition'] == 'Yes']
    data_age = data_attrition_yes['Age'].value_counts() 
    print(data_age)
  elif(ch==5): 
    print("Education field as a factor in Bar Graph")
    data_attrition_yes = data[data['Attrition'] == 'Yes']
    data_Education = data_attrition_yes['EducationField'].value_counts()
    data_Education = data_attrition_yes.groupby('Age')['EducationField'].value_counts().unstack().plot(kind="bar",color=["Cyan","purple","brown","Crimson","grey","k"],figsize=(20, 16))
    plt.grid(color ='grey',linestyle ='-.', linewidth = 0.5,)
